# =============================================================================
# ENVIRONMENT VARIABLES — Skill Development Institute Platform
#
# HOW TO USE:
#   1. Copy this file to `.env.local`      ->  cp .env.local.example .env.local
#   2. Fill in real values for local dev.
#   3. NEVER commit `.env.local`. It is git-ignored on purpose.
#
# SECURITY RULES:
#   - Variables prefixed with NEXT_PUBLIC_ are embedded into client JS and are
#     VISIBLE TO EVERYONE. Only put non-sensitive values there.
#   - Everything else is SERVER-ONLY. Never read server secrets in a
#     "use client" component and never prefix them with NEXT_PUBLIC_.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (SERVER-ONLY — SECRET)
# MongoDB connection string. Local dev example below; use Atlas URI in prod.
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/institute

# -----------------------------------------------------------------------------
# APP (PUBLIC — safe for the browser)
# Canonical URL of the deployed site, used in metadata/links.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# PAYMENTS — Razorpay (SERVER-ONLY — SECRETS)
# The key id is used client-side at checkout time via a server-provided order.
# Do NOT expose the key secret anywhere.
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Public key ID for Razorpay Checkout (safe for browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# -----------------------------------------------------------------------------
# EMAIL — Resend (SERVER-ONLY — SECRET)
# Centralized email notification system for transactional emails.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional: sender display name (default: siteConfig.name)
RESEND_FROM_NAME=
# Optional: disable email delivery in development (default: true)
EMAIL_ENABLED=true

# -----------------------------------------------------------------------------
# MEDIA — Cloudinary (SERVER-ONLY — SECRETS) — USED FROM PHASE 8
# Learning-resource uploads (PDF/documents) are streamed to Cloudinary from
# the server only. NEVER prefix these with NEXT_PUBLIC_ — the API secret must
# never reach the browser bundle.
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: max learning-resource upload size in MB (default 25).
MAX_RESOURCE_FILE_SIZE_MB=25

# -----------------------------------------------------------------------------
# VIDEO — YouTube embeds (PUBLIC)
# Only the public video/playlist IDs used for course lesson embeds. No secret.
# Example: https://www.youtube.com/watch?v=dQw4w9WgXcQ -> dQw4w9WgXcQ
# Leave empty until the LMS video phase.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_YOUTUBE_ENABLED=false
